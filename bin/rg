#!/usr/bin/env python3
from pathlib import Path
import os
import sys
ROOT = Path(__file__).resolve().parents[1]
os.environ.setdefault("CXS_SHIM_PATH", str(Path(__file__).resolve()))
sys.path.insert(0, str(ROOT))
from cxs.cli import shim_rg_main
if __name__ == "__main__":
    raise SystemExit(shim_rg_main())
